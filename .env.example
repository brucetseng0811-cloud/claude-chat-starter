# 把這個檔案複製成 .env（同一層），然後照下面說明填。
#   cp .env.example .env
#
# .env 已經在 .gitignore 裡，不會被 commit 出去。

# ---------------------------------------------------------------------------
# 資料庫（單元 2 起）
# ---------------------------------------------------------------------------
# 對應 docker-compose.yml 的設定，直接用預設值就好，不用改。
# port 是 5433 不是 5432，避開你本機可能已經在跑的 PostgreSQL。
DATABASE_URL="postgresql://chat:chat@localhost:5433/chat?schema=public"

# ---------------------------------------------------------------------------
# 後端 / 前端
# ---------------------------------------------------------------------------
PORT=3001
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Anthropic API（單元 3 起）
# ---------------------------------------------------------------------------
# 去 https://console.anthropic.com/settings/keys 建一把新的 key。
# 注意：這是「API key」，跟你登入 Claude Code 用的帳號是兩回事，要另外儲值。
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Voyage AI embedding（單元 7 RAG 才需要）
# ---------------------------------------------------------------------------
# Anthropic 沒有自己的 embedding API，官方推薦搭配 Voyage AI。
# 去 https://dashboard.voyageai.com 註冊，voyage-4 系列有 200M 免費 token，
# 這門課的用量大概只會用掉萬分之一。
#
# 不想再辦一個帳號？單元 7 的講稿有提供「本地 embedding」的替代路線，
# 不需要金鑰，但首次啟動要下載模型。
VOYAGE_API_KEY=""
